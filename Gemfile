gem "jekyll", "~> 3.8.5"

gem "webrick", "~> 1.8"

# Ruby 4.0 no longer bundles CSV as part of the default standard library.
gem "csv", "~> 3.3"

# Required by safe_yaml when running on Ruby 4.0.
gem "base64", "~> 0.3"

# Required by Liquid when running on Ruby 4.0.
gem "bigdecimal", "~> 4.0"

# Required by Kramdown when running on Ruby 4.0.
gem "rexml", "~> 3.4"
